# EdgeDock web frontend (static SPA on nginx, proxies /api, /raw, /dav to the server)
# Build from the repository root:
#   docker build -f docker/Dockerfile.web -t edgedock-web .

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY web/package.json web/package.json
RUN npm ci --workspace web --include-workspace-root=false
COPY web web
# Same-origin API behind the nginx proxy; override for a split deployment.
ARG VITE_API_BASE=
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build --workspace web

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 80
